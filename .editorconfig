# EditorConfig is awesome: https://editorconfig.org
#
# Top-level defaults for the RetailSystem_RK3568 repository.
# Editors that support EditorConfig (VS Code, CLion, Qt Creator, vim,
# emacs, ...) pick these up automatically.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_size = 4

[*.{pro,pri,prf}]
indent_size = 4

[CMakeLists.txt,*.cmake]
indent_size = 4

[Makefile]
# Makefiles require tab indentation
indent_style = tab

[*.sh]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

[*.{json,yaml,yml}]
indent_size = 2

[*.{ui,qrc}]
indent_size = 4
